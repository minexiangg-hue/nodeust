# Dedicated MySQL account for NODE. Do not use the MySQL root account.
DATABASE_URL="mysql://nodeust:replace-with-a-strong-password@127.0.0.1:3306/nodeust"
DB_POOL_SIZE=10

# Set this after ITSO registers the production SSO application.
# It should point to the trusted server-side SSO start endpoint or gateway.
HKUST_SSO_START_URL=

# Legacy mode only: existing SSO/preview Owner bootstrap behavior.
# Email mode does not use this setting or first-user promotion.
NODE_OWNER_EMAIL=

# Shared only between the trusted SSO proxy and NODE. External identity headers
# are rejected in production unless this value matches x-node-proxy-secret.
NODE_TRUSTED_PROXY_SECRET=

# Planned maintenance: set true to replace the home page with a lightweight notice.
NODE_MAINTENANCE_MODE=false
NODE_MAINTENANCE_RETURN="Check back soon"
NODE_STATUS_URL=

# Independent email authentication. Legacy is the default until a planned cutover.
# Email mode NEVER reuses DATABASE_URL, legacy identities, users, posts or chats.
NODE_AUTH_MODE=legacy
NODE_EMAIL_DATABASE_URL=
NODE_EMAIL_ORIGIN=https://nodeust.duckdns.org
# Configure before first production sign-up; no automatic first-user Owner.
NODE_EMAIL_OWNER_EMAIL=
# Independent random secret, at least 32 characters, for hashing rate-limit buckets.
NODE_EMAIL_RATE_SECRET=
NODE_EMAIL_MAIL_TRANSPORT=smtp
NODE_EMAIL_FROM=
NODE_EMAIL_SMTP_HOST=
NODE_EMAIL_SMTP_PORT=587
NODE_EMAIL_SMTP_USER=
NODE_EMAIL_SMTP_PASSWORD=
# Keep false in production. File mail is restricted to loopback + a test-only DB.
NODE_EMAIL_TEST_MODE=false
