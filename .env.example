# Dedicated MySQL account for NODE. Do not use the MySQL root account.
DATABASE_URL="mysql://nodeust:replace-with-a-strong-password@127.0.0.1:3306/nodeust"
DB_POOL_SIZE=10

# Set this after ITSO registers the production SSO application.
# It should point to the trusted server-side SSO start endpoint or gateway.
HKUST_SSO_START_URL=

# Optional bootstrap safety: this verified HKUST email is promoted to Owner.
# The very first verified account also becomes Owner when the database is empty.
NODE_OWNER_EMAIL=

# Shared only between the trusted SSO proxy and NODE. External identity headers
# are rejected in production unless this value matches x-node-proxy-secret.
NODE_TRUSTED_PROXY_SECRET=

# Planned maintenance: set true to replace the home page with a lightweight notice.
NODE_MAINTENANCE_MODE=false
NODE_MAINTENANCE_RETURN="Check back soon"
NODE_STATUS_URL=
